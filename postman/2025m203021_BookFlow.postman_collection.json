{
  "info": {
    "name": "2025m203021_BookFlow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "inventory",
      "value": "http://127.0.0.1:8001"
    },
    {
      "key": "orders",
      "value": "http://127.0.0.1:8002"
    },
    {
      "key": "orderKey",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Inventory before order",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{inventory}}/books"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Place order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{orderKey}}"
          }
        ],
        "url": "{{orders}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer\": \"Vattikunta Vishnu Priya\",\n  \"sku\": \"BOOK-001\",\n  \"quantity\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"orderKey\", \"postman-\" + pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"orderId\", pm.response.json().id);",
              "pm.test(\"Confirmed\", () => pm.expect(pm.response.json().status).to.eql(\"CONFIRMED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Read order",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{orders}}/orders/{{orderId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Replay same order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{orderKey}}"
          }
        ],
        "url": "{{orders}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer\": \"Vattikunta Vishnu Priya\",\n  \"sku\": \"BOOK-001\",\n  \"quantity\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Inventory after order",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{inventory}}/books/BOOK-001"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Insufficient stock",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{orderKey}}-reject"
          }
        ],
        "url": "{{orders}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer\": \"Vattikunta Vishnu Priya\",\n  \"sku\": \"BOOK-001\",\n  \"quantity\": 1000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Rejected\", () => pm.expect(pm.response.json().status).to.eql(\"REJECTED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Invalid quantity",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{orderKey}}-bad"
          }
        ],
        "url": "{{orders}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer\": \"Vattikunta Vishnu Priya\",\n  \"sku\": \"BOOK-001\",\n  \"quantity\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Conflicting key",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{orderKey}}"
          }
        ],
        "url": "{{orders}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer\": \"Vattikunta Vishnu Priya\",\n  \"sku\": \"BOOK-001\",\n  \"quantity\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Private endpoint without token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{inventory}}/reservations",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"order_id\": \"unauthorized\",\n  \"sku\": \"BOOK-001\",\n  \"quantity\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
